# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Port 3001 (bukan 3000) supaya tidak bentrok dengan backend proyek lain yang memakai 3000.
PORT=3001

# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgres://localhost:5432/vita_travel
# Database terpisah untuk `npm test` (isinya dihapus setiap test berjalan)
TEST_DATABASE_URL=postgres://localhost:5432/vita_travel_test

# --- Database daring (Aiven) ---
# Salin Service URI dari halaman layanan Aiven. Parameter ?sslmode=require yang ikut
# tersalin SEBAIKNYA DIHAPUS: pada pg-connection-string v2 parameter itu menimpa
# pengaturan SSL di kode dan membuat sertifikat Aiven ditolak. SSL sudah ditangani
# lewat berkas certs/aiven-ca.pem.
# Contoh: DATABASE_URL=postgres://avnadmin:SANDI@pg-xxxx.aivencloud.com:12345/defaultdb
#
# DATABASE_CA hanya dipakai bila hosting tidak menyertakan berkas certs/aiven-ca.pem.
# Isinya adalah teks sertifikat itu sendiri.

# Ganti dengan string acak yang panjang, misalnya hasil: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d



